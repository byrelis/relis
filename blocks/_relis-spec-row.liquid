{% doc %}
  Una riga della tabella misure: easyJet · 45 × 36 × 20 · Gratis sotto il
  sedile. Etichetta a sinistra, misura mono a destra, una nota facoltativa
  sotto a tutta larghezza.
{% enddoc %}

<div class="rl-specs__row" {{ block.shopify_attributes }}>
  <dt>{{ block.settings.label }}</dt>
  <dd>{{ block.settings.value }}</dd>
  {%- if block.settings.nota != blank -%}
    <dd class="rl-specs__nota">{{ block.settings.nota }}</dd>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Riga",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etichetta",
      "default": "easyJet"
    },
    {
      "type": "text",
      "id": "value",
      "label": "Misura",
      "default": "45 × 36 × 20"
    },
    {
      "type": "text",
      "id": "nota",
      "label": "Nota",
      "default": "Gratis sotto il sedile"
    }
  ]
}
{% endschema %}
