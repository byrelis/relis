{% doc %}
  Una riga dell'elenco numerato. Il numero lo aggiunge il CSS.
{% enddoc %}

<li class="rl-elenco__riga" {{ block.shopify_attributes }}>{{ block.settings.testo }}</li>

{% schema %}
{
  "name": "Riga",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "testo",
      "label": "Testo",
      "default": "Scomparto laptop imbottito"
    }
  ]
}
{% endschema %}
