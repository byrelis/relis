<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="it"
>
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    >
    <meta
      name="theme-color"
      content="#61473b"
    >

    <title>relis · In arrivo</title>
    <meta
      name="description"
      content="relis, borse da viaggio. Stiamo arrivando: lasciaci la tua email e sarai tra i primi a saperlo."
    >

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Layout autonomo: niente stili, script o schemi colore di Horizon.
      Solo i font e il foglio della pagina password, ospitati nel tema.
    {% endcomment %}
    {%- render 'relis-password-fonts' -%}
    {{ 'relis-password.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body>
    <div id="MainContent">
      {{ content_for_layout }}
    </div>
  </body>
</html>
