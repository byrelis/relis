{% doc %}
  Carica le quattro famiglie dell'identita relis.

  Nessuna delle quattro esiste nella libreria font di Shopify, quindi il
  font_picker delle impostazioni tema non puo servirle: le famiglie scelte
  nell'editor restano come ripiego e vengono sostituite in assets/relis.css.

  I file sono ospitati nel tema, non chiamati dal CDN di Google: il negozio
  e italiano, e quel CDN trasmette l'IP del visitatore a un terzo.

  Sottoinsiemi: solo latin e latin-ext. Il latin comprende U+2212, il segno
  meno vero del selettore di quantita.

  Bodoni Moda e Hanken Grotesk sono variabili: un file copre tutti i pesi
  usati, ed e dichiarato una volta sola con un intervallo di peso. DM Mono
  e statico, un file per peso.

  RESTA DA VERIFICARE: la licenza web di Open Sauce Sans, usata solo per
  il logotipo.
{% enddoc %}

{% liquid
  assign latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
  assign latin_ext = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF'
%}

{% comment %}
  Precarico i tagli sopra la piega: il corpo, il corsivo dei titoli, il
  mono della barra annunci e il logotipo.
{% endcomment %}
{{ 'hanken-grotesk-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'bodoni-moda-italic-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'dm-mono-400-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'open-sauce-sans-600-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

{% style %}
  /* ── Bodoni Moda — titoli, sempre corsivo ──
     Variabile anche sull'asse della dimensione ottica: il disegno si
     adatta da solo fra i 26px di una card e gli 84px della copertina. */
  @font-face {
    font-family: "Bodoni Moda";
    font-style: italic;
    font-weight: 400 500;
    font-display: swap;
    src: url("{{ 'bodoni-moda-italic-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Bodoni Moda";
    font-style: italic;
    font-weight: 400 500;
    font-display: swap;
    src: url("{{ 'bodoni-moda-italic-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── Hanken Grotesk — corpo, navigazione, bottoni ── */
  @font-face {
    font-family: "Hanken Grotesk";
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url("{{ 'hanken-grotesk-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Hanken Grotesk";
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url("{{ 'hanken-grotesk-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── DM Mono — timbri, misure, prezzi, numeri ── */
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'dm-mono-400-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'dm-mono-400-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'dm-mono-500-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'dm-mono-500-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── Open Sauce Sans — solo il logotipo ── */
  @font-face {
    font-family: "Open Sauce Sans";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'open-sauce-sans-500-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Open Sauce Sans";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("{{ 'open-sauce-sans-600-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }
{% endstyle %}
