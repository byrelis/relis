{% doc %}
  Carica le quattro famiglie del design system relis.

  Nessuna delle quattro esiste nella libreria font di Shopify, quindi il
  font_picker delle impostazioni tema non puo servirle: le famiglie
  scelte nell'editor restano come ripiego e vengono sostituite in
  assets/relis.css.

  I file sono ospitati nel tema, non chiamati da un CDN esterno. Due
  ragioni: il negozio e italiano e il CDN di Google trasmette l'IP del
  visitatore a un terzo, cosa che in UE e stata contestata piu volte; e
  passando dalla CDN di Shopify i font arrivano dallo stesso host del
  resto della pagina.

  Sottoinsiemi: solo latin e latin-ext. Gli altri — cirillico, greco,
  vietnamita — sono stati scartati: il sito e in italiano e inglese.
  Il latin comprende U+2212, il segno meno vero che accordion e
  selettore di quantita usano al posto del trattino.

  Inter Tight e un font variabile: 400 e 500 sono lo stesso file, ed e
  dichiarato una volta sola con un intervallo di peso.

  RESTA DA VERIFICARE: la licenza web di Open Sauce Sans. Il file arriva
  da Fontsource ed e usato solo per il logotipo. Vedi il punto 4 delle
  questioni aperte nel readme del design system.
{% enddoc %}

{% liquid
  assign latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
  assign latin_ext = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF'
%}

{% comment %}
  Precarico i tre tagli che compaiono sopra la piega: il corpo, il serif
  dei titoli e il logotipo nella barra. Il resto arriva quando serve.
{% endcomment %}
{{ 'inter-tight-400-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'instrument-serif-400-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'open-sauce-sans-600-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

{% style %}
  /* ── Instrument Serif — display, H1, H2, H3, nomi di prodotto ──
     Non scende mai sotto i 22px: sotto quella soglia perde il disegno. */
  @font-face {
    font-family: "Instrument Serif";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'instrument-serif-400-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Instrument Serif";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'instrument-serif-400-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  @font-face {
    font-family: "Instrument Serif";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'instrument-serif-400-italic-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Instrument Serif";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'instrument-serif-400-italic-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── Inter Tight — corpo, apertura, maiuscoletti, bottoni ──
     Variabile: un file solo copre 400 e 500. */
  @font-face {
    font-family: "Inter Tight";
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url("{{ 'inter-tight-400-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Inter Tight";
    font-style: normal;
    font-weight: 400 500;
    font-display: swap;
    src: url("{{ 'inter-tight-400-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── IBM Plex Mono — di servizio: numeri tecnici, i segni + e − ── */
  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'ibm-plex-mono-400-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ 'ibm-plex-mono-400-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'ibm-plex-mono-500-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'ibm-plex-mono-500-latin-ext.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin_ext }};
  }

  /* ── Open Sauce Sans — solo il logotipo, e nient'altro ──
     Non e tipografia di sistema. Il dettaglio da proteggere e che il
     punto della i e un anello, non un cerchio pieno. */
  @font-face {
    font-family: "Open Sauce Sans";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ 'open-sauce-sans-500-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }

  @font-face {
    font-family: "Open Sauce Sans";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("{{ 'open-sauce-sans-600-latin.woff2' | asset_url }}") format("woff2");
    unicode-range: {{ latin }};
  }
{% endstyle %}
