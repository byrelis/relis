{% comment %}
  Copertina relis.

  Due o piu scatti a tutta pagina che si danno il cambio in dissolvenza,
  ciascuno col suo testo e il suo tono. E una sezione custom e non la
  slideshow di Horizon per due ragioni che il design rende obbligate: la
  slideshow scorre di lato, qui gli scatti si sovrappongono e sfumano in
  900ms; e le sue velature sono solo verticali, qui ogni scatto porta una
  velatura orizzontale che copre la meta sinistra, dove sta il testo, in
  tono opposto allo scatto — scura su uno chiaro, chiara su uno scuro.

  I controlli 01 · 02 stanno dentro ogni slide, cosi prendono il tono
  della slide che si sta guardando.

  Il cambio automatico si ferma quando il puntatore o il fuoco sono sulla
  copertina, e non parte affatto con prefers-reduced-motion: un contenuto
  che si muove da solo deve potersi fermare.
{% endcomment %}

<relis-copertina
  class="relis-copertina"
  data-autoplay="{{ section.settings.autoplay }}"
  data-secondi="{{ section.settings.secondi }}"
  aria-roledescription="carosello"
  aria-label="{{ section.settings.etichetta | escape }}"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign slide = block.settings
      assign attiva = forloop.first
      assign tono = slide.tono | default: 'scuro'
    -%}
    <div
      class="relis-copertina__slide relis-copertina__slide--{{ tono }}"
      data-slide
      {% if attiva %}
        data-attiva
      {% else %}
        aria-hidden="true" inert
      {% endif %}
      aria-roledescription="slide"
      aria-label="{{ forloop.index }} di {{ forloop.length }}"
      style="--posizione-x: {{ slide.posizione_x }}%;"
      {{ block.shopify_attributes }}
    >
      {%- if slide.immagine != blank -%}
        {%- liquid
          assign carica = 'lazy'
          assign priorita = 'auto'
          if forloop.first and section.index <= 2
            assign carica = 'eager'
            assign priorita = 'high'
          endif
        -%}
        {{
          slide.immagine
          | image_url: width: 3200
          | image_tag:
            class: 'relis-copertina__scatto',
            sizes: '100vw',
            widths: '750, 1100, 1500, 2000, 2600, 3200',
            loading: carica,
            fetchpriority: priorita
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'relis-copertina__scatto' }}
      {%- endif -%}

      <div class="relis-copertina__velatura" aria-hidden="true"></div>

      <div class="relis-copertina__contenuto">
        <div class="relis-copertina__testo">
          {%- if slide.timbro != blank -%}
            <span class="relis-copertina__timbro">{{ slide.timbro }}</span>
          {%- endif -%}
          {%- if slide.titolo != blank -%}
            {%- if forloop.first -%}
              <h1 class="relis-copertina__titolo">{{ slide.titolo | escape | newline_to_br }}</h1>
            {%- else -%}
              <h2 class="relis-copertina__titolo">{{ slide.titolo | escape | newline_to_br }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if slide.apertura != blank -%}
            <p class="relis-copertina__apertura">{{ slide.apertura }}</p>
          {%- endif -%}
          {%- if slide.etichetta != blank -%}
            <a class="relis-copertina__azione" href="{{ slide.link | default: '#' }}">{{ slide.etichetta }}</a>
          {%- endif -%}
        </div>
      </div>

      {%- if forloop.length > 1 -%}
        <div class="relis-copertina__controlli">
          {%- for i in (1..forloop.length) -%}
            <button
              type="button"
              class="relis-copertina__controllo"
              data-vai="{{ forloop.index0 }}"
              aria-label="Mostra la copertina {{ i }} di {{ forloop.length }}"
              {% if i == forloop.parentloop.index %}
                aria-current="true"
              {% endif %}
            >
              {{- i | prepend: '0' | slice: -2, 2 -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</relis-copertina>

{% stylesheet %}
  .relis-copertina {
    position: relative;
    display: block;
    min-height: clamp(540px, 58vw, 720px);
    overflow: hidden;
    background: var(--photo-bg);
  }

  .relis-copertina__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slide) var(--ease);
  }

  .relis-copertina__slide[data-attiva] {
    opacity: 1;
    pointer-events: auto;
  }

  .relis-copertina__scatto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--posizione-x, 75%) 50%;
  }

  .relis-copertina__velatura {
    position: absolute;
    inset: 0;
  }

  .relis-copertina__contenuto {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 56px var(--page-margin);
  }

  .relis-copertina__testo {
    max-width: min(600px, 94%);
  }

  .relis-copertina__timbro {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
  }

  .relis-copertina__titolo {
    font-family: var(--serif);
    font-style: italic;
    font-weight: var(--w-regular);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    margin: 18px 0 20px;
  }

  .relis-copertina__apertura {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    max-width: var(--measure-lead);
    margin: 0 0 32px;
  }

  .relis-copertina__azione {
    display: inline-block;
    font-family: var(--sans);
    font-size: var(--fs-button);
    letter-spacing: var(--tr-button);
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--pad-button);
    border-radius: var(--r-pill);
    transition: var(--t-color);
  }

  .relis-copertina__controlli {
    position: absolute;
    left: var(--page-margin);
    bottom: 28px;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .relis-copertina__controllo {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: var(--rule-accent) solid var(--controllo-spento-bordo);
    color: var(--controllo-spento);
    padding: 4px 2px;
    min-height: var(--tap-min);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    transition: var(--t-color);
  }

  .relis-copertina__controllo:hover {
    color: var(--controllo-acceso);
  }

  .relis-copertina__controllo[aria-current='true'] {
    border-bottom-color: var(--controllo-acceso);
    color: var(--controllo-acceso);
  }

  /* Tono scuro: velatura inchiostro-marrone, testo crema. */
  .relis-copertina__slide--scuro {
    color: var(--on-dark);
    --controllo-acceso: #f1eee9;
    --controllo-spento: rgba(241, 238, 233, 0.6);
    --controllo-spento-bordo: rgba(241, 238, 233, 0.3);
  }

  .relis-copertina__slide--scuro .relis-copertina__velatura {
    background: var(--veil-dark);
  }

  .relis-copertina__slide--scuro .relis-copertina__timbro {
    color: #e6ded4;
  }

  .relis-copertina__slide--scuro .relis-copertina__apertura {
    color: #ede4d8;
  }

  .relis-copertina__slide--scuro .relis-copertina__azione {
    background: var(--on-dark);
    color: var(--ink);
  }

  .relis-copertina__slide--scuro .relis-copertina__azione:hover {
    background: var(--azzurro-tint);
  }

  /* Tono chiaro: velatura avorio, testo inchiostro. */
  .relis-copertina__slide--chiaro {
    color: var(--ink);
    --controllo-acceso: #1c1411;
    --controllo-spento: rgba(28, 20, 17, 0.55);
    --controllo-spento-bordo: rgba(28, 20, 17, 0.28);
  }

  .relis-copertina__slide--chiaro .relis-copertina__velatura {
    background: var(--veil-light);
  }

  .relis-copertina__slide--chiaro .relis-copertina__timbro {
    color: var(--brand);
  }

  .relis-copertina__slide--chiaro .relis-copertina__apertura {
    color: var(--brand-deep);
  }

  .relis-copertina__slide--chiaro .relis-copertina__azione {
    background: var(--ink);
    color: var(--on-dark);
  }

  .relis-copertina__slide--chiaro .relis-copertina__azione:hover {
    background: var(--brand);
  }
{% endstylesheet %}

{% javascript %}
  class RelisCopertina extends HTMLElement {
    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('[data-slide]'));
      this.indice = 0;
      const menoMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.automatico = this.dataset.autoplay === 'true' && !menoMovimento;
      this.secondi = Math.max(2, Number(this.dataset.secondi) || 5);

      this.alClic = (evento) => {
        const bottone = evento.target.closest('[data-vai]');
        if (bottone) this.vai(Number(bottone.dataset.vai));
      };
      this.ferma = () => clearInterval(this.timer);
      this.riprendi = () => this.avvia();
      this.inEditor = (evento) => {
        const i = this.slides.indexOf(evento.target.closest('[data-slide]'));
        if (i >= 0) {
          this.ferma();
          this.mostra(i);
        }
      };

      this.addEventListener('click', this.alClic);
      this.addEventListener('mouseenter', this.ferma);
      this.addEventListener('mouseleave', this.riprendi);
      this.addEventListener('focusin', this.ferma);
      this.addEventListener('focusout', this.riprendi);
      document.addEventListener('shopify:block:select', this.inEditor);

      this.avvia();
    }

    disconnectedCallback() {
      this.ferma();
      document.removeEventListener('shopify:block:select', this.inEditor);
    }

    mostra(i) {
      this.indice = i;
      this.slides.forEach((slide, j) => {
        const attiva = j === i;
        slide.toggleAttribute('data-attiva', attiva);
        slide.toggleAttribute('inert', !attiva);
        slide.setAttribute('aria-hidden', String(!attiva));
        slide.querySelectorAll('[data-vai]').forEach((bottone) => {
          if (Number(bottone.dataset.vai) === i) bottone.setAttribute('aria-current', 'true');
          else bottone.removeAttribute('aria-current');
        });
      });
    }

    vai(i) {
      this.mostra(i);
      this.avvia();
    }

    avvia() {
      this.ferma();
      if (!this.automatico || this.slides.length < 2) return;
      this.timer = setInterval(() => {
        this.mostra((this.indice + 1) % this.slides.length);
      }, this.secondi * 1000);
    }
  }

  if (!customElements.get('relis-copertina')) {
    customElements.define('relis-copertina', RelisCopertina);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Copertina",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "slide",
      "name": "Copertina",
      "settings": [
        {
          "type": "image_picker",
          "id": "immagine",
          "label": "Scatto"
        },
        {
          "type": "range",
          "id": "posizione_x",
          "label": "Inquadratura orizzontale",
          "info": "Dove sta la borsa nello scatto. Il testo occupa la meta sinistra: la borsa va tenuta a destra.",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 75
        },
        {
          "type": "select",
          "id": "tono",
          "label": "Tono",
          "info": "Scuro su uno scatto chiaro, chiaro su uno scatto scuro: la velatura va in contrasto con la foto, non con la pagina.",
          "options": [
            {
              "value": "scuro",
              "label": "Scuro, testo crema"
            },
            {
              "value": "chiaro",
              "label": "Chiaro, testo inchiostro"
            }
          ],
          "default": "scuro"
        },
        {
          "type": "text",
          "id": "timbro",
          "label": "Timbro",
          "info": "Il ritmo di una misura o di un luogo. Non ripete il titolo.",
          "default": "Fuga 26 · 44 × 32 × 18,5 cm"
        },
        {
          "type": "textarea",
          "id": "titolo",
          "label": "Titolo",
          "info": "Vai a capo per spezzare la riga, come nel design.",
          "default": "Due notti.\nTutto al suo posto."
        },
        {
          "type": "textarea",
          "id": "apertura",
          "label": "Apertura",
          "default": "La borsa da viaggio che passa sotto il sedile easyJet."
        },
        {
          "type": "text",
          "id": "etichetta",
          "label": "Bottone",
          "default": "Scopri Fuga 26"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collegamento"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "etichetta",
      "label": "Nome per i lettori di schermo",
      "default": "Copertina"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Cambio automatico",
      "info": "Si ferma sotto il puntatore e con il fuoco da tastiera. Non parte per chi ha chiesto meno movimento.",
      "default": true
    },
    {
      "type": "range",
      "id": "secondi",
      "label": "Durata di ogni copertina",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Copertina",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "tono": "chiaro"
          }
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
