{% comment %}
  Pagina password relis — da Claude Design, «Pagina Password».

  Tre stati nello stesso riquadro: iscrizione, grazie, password.
  L'iscrizione usa il form newsletter nativo (form 'customer' con il tag
  newsletter): il contatto finisce in Clienti con il consenso marketing.
  Gli stili stanno in assets/relis-password.css.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign stato = 'email'

  assign indirizzo = s.indirizzo | strip
  assign piva = s.piva | strip
  assign rea = s.rea | strip | remove_first: 'LC-'
  assign email = s.email | strip
  assign ragione_sociale = s.ragione_sociale | strip
-%}

{%- capture blocco_email -%}
  {%- form 'customer', id: 'relis-iscrizione', class: 'rp__form', novalidate: 'novalidate' -%}
    {%- liquid
      if form.posted_successfully?
        assign stato = 'grazie'
      endif
      assign errore_email = ''
      if form.errors
        assign errore_email = "Controlla l'indirizzo email."
      endif
    -%}
    <input
      type="hidden"
      name="contact[tags]"
      value="newsletter"
    >
    <label
      for="relis-email"
      class="rp__etichetta"
    >La tua email</label>
    <input
      id="relis-email"
      class="rp__campo"
      type="email"
      name="contact[email]"
      autocomplete="email"
      inputmode="email"
      autocapitalize="off"
      placeholder="La tua email"
      value="{{ form.email }}"
      aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
      aria-describedby="relis-email-err"
    >
    <button
      type="submit"
      class="rp__invio"
    >
      Avvisami
    </button>
  {%- endform -%}
{%- endcapture -%}

{%- capture blocco_password -%}
  {%- form 'storefront_password', id: 'relis-accesso', class: 'rp__form', novalidate: 'novalidate' -%}
    {%- liquid
      assign errore_password = ''
      if form.errors
        assign stato = 'password'
        assign errore_password = 'Password non corretta. Riprova.'
      endif
    -%}
    <label
      for="relis-pw"
      class="rp__etichetta"
    >Password</label>
    <input
      id="relis-pw"
      class="rp__campo"
      type="password"
      name="password"
      autocomplete="current-password"
      placeholder="Password"
      aria-invalid="{% if form.errors %}true{% else %}false{% endif %}"
      aria-describedby="relis-pw-err"
    >
    <button
      type="submit"
      class="rp__invio"
    >
      Entra
    </button>
  {%- endform -%}
{%- endcapture -%}

<div
  class="rp"
  data-relis-password
  data-iscritto="{% if stato == 'grazie' %}true{% else %}false{% endif %}"
>
  <div
    class="rp__sfondo"
    aria-hidden="true"
  ></div>
  <div
    class="rp__grana"
    aria-hidden="true"
  ></div>

  <main class="rp__main">
    <h1 class="rp__marchio">
      {{- 'relis-logo.svg' | inline_asset_content -}}
    </h1>

    {%- if s.slogan != blank -%}
      <p class="rp__slogan">{{ s.slogan | escape }}</p>
    {%- endif -%}

    <div class="rp__pannello">
      <div
        class="rp__stato"
        data-stato="email"
        {% if stato != 'email' %}
          hidden
        {% endif %}
      >
        {%- if s.testo != blank -%}
          <p class="rp__testo">{{ s.testo | escape | newline_to_br }}</p>
        {%- endif -%}
        {{ blocco_email }}
        <p
          id="relis-email-err"
          class="rp__errore"
          role="alert"
        >
          {{- errore_email -}}
        </p>
        <p class="rp__consenso">
          Iscrivendoti accetti di ricevere email da relis su novità e lancio. Puoi disiscriverti in qualsiasi momento.
          I tuoi dati sono trattati secondo il Regolamento UE 2016/679
          {%- if s.informativa != blank -%}
            :
            <button
              type="button"
              class="rp__link-testo"
              data-apri-informativa
              aria-haspopup="dialog"
              aria-controls="relis-informativa"
            >informativa privacy</button>.
          {%- else -%}
            .
          {%- endif %}
        </p>
      </div>

      <div
        class="rp__stato"
        data-stato="grazie"
        {% if stato != 'grazie' %}
          hidden
        {% endif %}
      >
        <p
          class="rp__grazie"
          role="status"
        >
          Grazie, ci sentiamo presto.
        </p>
      </div>

      <div
        class="rp__stato"
        data-stato="password"
        {% if stato != 'password' %}
          hidden
        {% endif %}
      >
        <p class="rp__testo">Inserisci la password del negozio.</p>
        {{ blocco_password }}
        <p
          id="relis-pw-err"
          class="rp__errore"
          role="alert"
        >
          {{- errore_password -}}
        </p>
        <button
          type="button"
          class="rp__link rp__link--torna"
          data-torna
        >
          Torna all'iscrizione
        </button>
      </div>
    </div>
  </main>

  <footer class="rp__piede">
    <button
      type="button"
      class="rp__link rp__link--accedi"
      data-accedi
      aria-expanded="{% if stato == 'password' %}true{% else %}false{% endif %}"
    >
      Accedi utilizzando la password
    </button>

    {%- comment -%} Riga legale: un campo vuoto non lascia il suo separatore. {%- endcomment -%}
    {%- capture legale -%}
      {%- if ragione_sociale != blank -%}{{ ragione_sociale | escape }}|||{%- endif -%}
      {%- if indirizzo != blank -%}{{ indirizzo | escape }}|||{%- endif -%}
      {%- if piva != blank -%}P.IVA {{ piva | escape }}|||{%- endif -%}
      {%- if rea != blank -%}REA LC-{{ rea | escape }}|||{%- endif -%}
      {%- if email != blank -%}<a href="mailto:{{ email | escape }}">{{ email | escape }}</a>{%- endif -%}
    {%- endcapture -%}
    {%- assign voci = legale | split: '|||' -%}
    {%- if voci.size > 0 -%}
      <p class="rp__legale">{{ voci | join: ' · ' }}</p>
    {%- endif -%}
  </footer>

  {%- comment -%}
    Informativa privacy: dialog nativo aperto con showModal(), che da solo
    chiude con Esc, tiene il fuoco dentro il riquadro e lo restituisce al link.
  {%- endcomment -%}
  {%- if s.informativa != blank -%}
    <dialog
      id="relis-informativa"
      class="rp-modale"
      aria-labelledby="relis-informativa-titolo"
    >
      <div class="rp-modale__testata">
        <h2
          id="relis-informativa-titolo"
          class="rp-modale__titolo"
        >
          Informativa privacy
        </h2>
        <button
          type="button"
          class="rp-modale__chiudi"
          data-chiudi-informativa
          aria-label="Chiudi"
        >
          <svg
            viewBox="0 0 20 20"
            width="20"
            height="20"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 4l12 12M16 4L4 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />
          </svg>
        </button>
      </div>
      <div
        class="rp-modale__corpo"
        tabindex="0"
      >
        {{ s.informativa }}
      </div>
    </dialog>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('[data-relis-password]');
    if (!root) return;

    var stati = root.querySelectorAll('[data-stato]');
    var accedi = root.querySelector('[data-accedi]');
    var torna = root.querySelector('[data-torna]');
    var iscrizione = root.querySelector('#relis-iscrizione');
    var campoEmail = root.querySelector('#relis-email');
    var erroreEmail = root.querySelector('#relis-email-err');
    var campoPw = root.querySelector('#relis-pw');
    var riposo = root.dataset.iscritto === 'true' ? 'grazie' : 'email';

    function attuale() {
      for (var i = 0; i < stati.length; i++) {
        if (!stati[i].hidden) return stati[i].dataset.stato;
      }
      return riposo;
    }

    function mostra(nome) {
      for (var i = 0; i < stati.length; i++) {
        stati[i].hidden = stati[i].dataset.stato !== nome;
      }
      accedi.setAttribute('aria-expanded', nome === 'password' ? 'true' : 'false');
      if (nome === 'password' && campoPw) campoPw.focus();
    }

    accedi.addEventListener('click', function () {
      mostra(attuale() === 'password' ? riposo : 'password');
    });

    torna.addEventListener('click', function () {
      mostra(riposo);
    });

    function segnala(messaggio) {
      erroreEmail.textContent = messaggio;
      campoEmail.setAttribute('aria-invalid', messaggio ? 'true' : 'false');
    }

    var modale = root.querySelector('#relis-informativa');
    var apri = root.querySelector('[data-apri-informativa]');

    if (modale && apri && typeof modale.showModal === 'function') {
      apri.addEventListener('click', function () {
        modale.showModal();
      });

      modale.querySelector('[data-chiudi-informativa]').addEventListener('click', function () {
        modale.close();
      });

      // Un clic sul velo, fuori dal riquadro, chiude.
      modale.addEventListener('click', function (event) {
        if (event.target === modale) modale.close();
      });
    }

    if (iscrizione && campoEmail) {
      campoEmail.addEventListener('input', function () {
        segnala('');
      });

      iscrizione.addEventListener('submit', function (event) {
        var valore = campoEmail.value.trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(valore)) {
          event.preventDefault();
          segnala(valore ? "Controlla l'indirizzo email." : 'Scrivi la tua email.');
          campoEmail.focus();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Password",
  "class": "relis-password-section",
  "settings": [
    {
      "type": "header",
      "content": "Testi"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "Dal primo caffè all'ultimo treno."
    },
    {
      "type": "textarea",
      "id": "testo",
      "label": "Testo",
      "default": "Stiamo arrivando. Lasciaci la tua email e sarai tra i primi a saperlo."
    },
    {
      "type": "richtext",
      "id": "informativa",
      "label": "Informativa privacy",
      "info": "Si apre in un riquadro sopra la pagina dal link «informativa privacy». Se vuoto, il link non compare.",
      "default": "<p>Testo dell'informativa privacy: da inserire.</p>"
    },
    {
      "type": "header",
      "content": "Dati legali (piè di pagina)"
    },
    {
      "type": "text",
      "id": "ragione_sociale",
      "label": "Ragione sociale",
      "default": "relis di Anays Salcedo"
    },
    {
      "type": "text",
      "id": "indirizzo",
      "label": "Indirizzo sede legale"
    },
    {
      "type": "text",
      "id": "piva",
      "label": "P.IVA",
      "default": "04319220135"
    },
    {
      "type": "text",
      "id": "rea",
      "label": "Numero REA",
      "info": "Solo il numero: «REA LC-» viene aggiunto da solo."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "its.relis.store@gmail.com"
    }
  ]
}
{% endschema %}
